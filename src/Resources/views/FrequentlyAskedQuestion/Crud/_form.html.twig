{% from '@BitBagSyliusCmsPlugin/Macro/translationForm.html.twig' import translationForm %}
{% form_theme form '@BitBagSyliusCmsPlugin/Form/theme.html.twig' %}

{{ form_errors(form) }}

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-md-6">{{ form_row(form.code) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.position) }}</div>
        </div>
        {{ form_row(form.enabled) }}
        {{ form_row(form.channels) }}
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        {{ translationForm(form.translations) }}
    </div>
</div>
