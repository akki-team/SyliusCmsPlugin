{% form_theme form '@BitBagSyliusCmsPlugin/Form/theme.html.twig' %}
<div class="bitbag-cms-import" data-bb-cms-wrapper data-bb-target="cms-import">
    <form method="POST" enctype="multipart/form-data" action="{{ path('bitbag_sylius_cms_plugin_admin_import_data', {'resourceName': resourceName|default(app.request.attributes.get('resourceName'))}) }}" novalidate="novalidate">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="{{ 'bitbag_sylius_cms_plugin.ui.csv_file'|trans }}" data-bb-cms-text="text" readonly>
            {{ form_widget(form.file, { 'attr': {'data-bb-cms-file': 'file', 'class': 'd-none'} }) }}
            <button class="btn btn-primary" type="submit">
                {{ ux_icon('tabler:upload', {'class': 'icon'}) }}
                {{ 'bitbag_sylius_cms_plugin.ui.import'|trans }}
            </button>
        </div>
        {{ form_widget(form._token) }}
    </form>
</div>
