<div class="mb-3{% if slugField.vars.required %} required{% endif %}" data-bb-cms-slug-field>
    {{ form_label(slugField) }}
    {% if slugField.vars.value == null %}
        {{ form_widget(slugField, {'attr': {'data-url': path('bitbag_sylius_cms_plugin_admin_ajax_generate_page_slug')}}) }}
    {% else %}
        <div class="input-group">
            {{ form_widget(slugField, {'attr': {'readonly': 'readonly', 'data-url': path('bitbag_sylius_cms_plugin_admin_ajax_generate_page_slug')}}) }}
            <button type="button" class="btn btn-icon" data-bb-cms-toggle-slug aria-label="{{ 'bitbag_sylius_cms_plugin.ui.slug'|trans }}">
                <span data-bb-cms-slug-locked>{{ ux_icon('tabler:lock', {'class': 'icon'}) }}</span>
                <span data-bb-cms-slug-unlocked class="d-none">{{ ux_icon('tabler:lock-open', {'class': 'icon'}) }}</span>
            </button>
        </div>
    {% endif %}
    {{ form_errors(slugField) }}
</div>
