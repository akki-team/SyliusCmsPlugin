{% macro translationForm(translations, resource = null) %}
    {% from _self import translationFormWithSlug %}

    {{ translationFormWithSlug(translations, null, resource) }}
{% endmacro %}

{% macro translationFormWithSlug(translations, slugFieldTemplate = null, resource = null) %}
    {% import '@BitBagSyliusCmsPlugin/Macro/imageWidget.html.twig' as image %}
    {% import '@BitBagSyliusCmsPlugin/Macro/mediaWidget.html.twig' as media %}

    {% set accordion_id = 'bitbag-cms-translations-' ~ translations.vars.id %}
    <div class="accordion" id="{{ accordion_id }}"{% if slugFieldTemplate is not null %} data-bb-target="cms-slug-update"{% endif %}>
        {% for locale, translationForm in translations %}
            <div class="accordion-item" data-locale="{{ locale }}" data-bb-cms-wrapper>
                <h2 class="accordion-header">
                    <button
                        class="accordion-button{% if not loop.first %} collapsed{% endif %}"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#{{ accordion_id }}-{{ locale }}"
                        aria-expanded="{{ loop.first ? 'true' : 'false' }}"
                        aria-controls="{{ accordion_id }}-{{ locale }}"
                    >
                        {{ locale|sylius_locale_name }}
                    </button>
                </h2>
                <div id="{{ accordion_id }}-{{ locale }}" class="accordion-collapse collapse{% if loop.first %} show{% endif %}">
                    <div class="accordion-body">
                        {% for field in translationForm %}
                            {% if slugFieldTemplate is not null and field.vars.name == 'slug' %}
                                {% include slugFieldTemplate with { 'slugField': field, 'resource': resource } %}
                            {% elseif 'bitbag_media_autocomplete_choice' in field.vars.block_prefixes %}
                                {{ media.mediaWidget(field) }}
                            {% elseif 'image' == field.vars.name %}
                                {{ image.imageWidget(field) }}
                            {% else %}
                                {{ form_row(field) }}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
