{
  "name": "bitbag/cms-plugin",
  "type": "sylius-plugin",
  "keywords": [
    "sylius",
    "sylius-plugin",
    "sylius-cms"
  ],
  "description": "CMS plugin for Sylius applications.",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "sylius/sylius": "^2.3",
    "league/csv": "^9.1",
    "friendsofsymfony/ckeditor-bundle": "^2.7",
    "instaclick/php-webdriver": "^1.4",
    "symfony/webpack-encore-bundle": "^2.0"
  },
  "require-dev": {
    "api-platform/state": "^4.4",
    "behat/behat": "^3.7",
    "bitbag/coding-standard": "^3.0",
    "dbrekelmans/bdi": "^1.1",
    "dmore/behat-chrome-extension": "^1.3",
    "dmore/chrome-mink-driver": "^2.7",
    "doctrine/dbal": "^3.10",
    "friends-of-behat/mink": "^1.8",
    "friends-of-behat/mink-browserkit-driver": "^1.4",
    "friends-of-behat/mink-debug-extension": "^2.0.0",
    "friends-of-behat/mink-extension": "^2.4",
    "friends-of-behat/page-object-extension": "^0.3",
    "friends-of-behat/suite-settings-extension": "^1.0",
    "friends-of-behat/symfony-extension": "^2.6",
    "friends-of-behat/variadic-extension": "^1.3",
    "lchrusciel/api-test-case": "^5.3",
    "matthiasnoback/symfony-config-test": "^5.1",
    "phpspec/phpspec": "^8.3",
    "phpstan/extension-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "phpstan/phpstan-doctrine": "^1.5",
    "phpstan/phpstan-strict-rules": "^1.6",
    "phpstan/phpstan-webmozart-assert": "^1.2",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "robertfausk/behat-panther-extension": "^1.1",
    "sylius-labs/coding-standard": "^4.2",
    "sylius-labs/suite-tags-extension": "^0.2",
    "sylius/test-application": "^2.3.0@alpha",
    "symfony/browser-kit": "^7.4",
    "symfony/debug-bundle": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/flex": "^2.4",
    "symfony/intl": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/web-profiler-bundle": "^7.4"
  },
  "conflict": {
    "symfony/symfony": "4.1.8",
    "symfony/browser-kit": "4.1.8",
    "symfony/dom-crawler": "4.1.8",
    "symfony/routing": "4.1.8",
    "symfony/doctrine-bridge": "4.4.16"
  },
  "suggest": {
    "stefandoorn/sitemap-plugin": "^2.0@alpha",
    "jms/serializer-bundle": "Serialization metadata of the CMS models for JMS (legacy Sylius 1 shop API)"
  },
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "BitBag\\SyliusCmsPlugin\\": "src/",
      "Tests\\BitBag\\SyliusCmsPlugin\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\BitBag\\SyliusCmsPlugin\\": "spec/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "dealerdirect/phpcodesniffer-composer-installer": false,
      "phpstan/extension-installer": false,
      "symfony/flex": true,
      "symfony/runtime": true,
      "php-http/discovery": false
    }
  },
  "extra": {
    "branch-alias": {
      "dev-sylius-2": "5.0-dev"
    },
    "public-dir": "vendor/sylius/test-application/public",
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    },
    "symfony/flex": {
      "synchronize_package_json": false
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
