{% if channels|length > 0 %}
    {% set selected = channels|first %}
    {% set code = app.request.query.get('channel', selected.code) %}

    <div>
        <label for="bitbag_sylius_cms_plugin_channel_switch" class="form-label required">
            {{ 'sylius.ui.channel'|trans }}
        </label>
        <select id="bitbag_sylius_cms_plugin_channel_switch" data-bb-cms-channel class="form-select">
            {% for item in channels %}
                <option value="{{ item.code }}" {{ item.code is same as(code) ? 'selected' : '' }}>
                    {{ item.name }}
                </option>
            {% endfor %}
        </select>
    </div>
{% endif %}
