{% macro imageWidget(form) %}
    <div class="card mb-3">
        <div class="card-body">
            {{ form_row(form.type) }}
            {% if form.vars.value.path|default(null) is not null %}
                <img class="img-thumbnail mb-3" src="{{ form.vars.value.path|imagine_filter('sylius_small') }}" alt="{{ form.vars.value.type }}" />
            {% endif %}
            {{ form_row(form.file) }}
        </div>
    </div>
{% endmacro %}
