{% if page.sections|length > 0 %}
    <strong>{{ 'bitbag_sylius_cms_plugin.ui.sections'|trans }}:</strong>
    {% for section in page.sections %}
        <a href="{{ path('bitbag_sylius_cms_plugin_shop_page_index_by_section_code', {'sectionCode' : section.code}) }}" class="badge text-bg-light text-decoration-none">{{ section.name }}</a>
    {% endfor %}
{% endif %}
