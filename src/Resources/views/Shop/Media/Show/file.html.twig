{% if null != media.name %}
    <h2>{{ media.name|raw }}</h2>
{% endif %}

<p>{{ bitbag_cms_render_content(media) }}</p>

<a class="btn btn-primary" href="{{ path('bitbag_sylius_cms_plugin_shop_media_download', {'code': media.code}) }}">
    {{ ux_icon('tabler:download', {'class': 'icon'}) }}
    {{ 'bitbag_sylius_cms_plugin.ui.download'|trans }}
</a>
