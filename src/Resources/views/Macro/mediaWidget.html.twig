        {{ form_row(form) }}
        <a href="{{ path('bitbag_sylius_cms_plugin_admin_media_create') }}" target="_blank" class="btn btn-outline-primary btn-sm">
            {{ ux_icon('tabler:plus', {'class': 'icon'}) }}
            {{ 'sylius.ui.create'|trans }}
        </a>
    </div>
{% endmacro %}
